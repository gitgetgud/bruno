meta {
  name: Personal info
  type: http
  seq: 4
}

get {
  url: https://{{ARM_HOST}}/proxy/users-service/api/auth/personal
  body: none
  auth: inherit
}

headers {
  X-Fingerprint: {{X-Fingerprint}}
  Accept-Language: {{Accept-Language}}
  User-Agent: {{User-Agent}}
  Authorization:  Bearer {{JWT_ACCESS_TOKEN}}
}

settings {
  encodeUrl: true
}
