meta {
  name: Смена пароля
  type: http
  seq: 5
}

post {
  url: https://{{ARM_HOST}}/proxy/users-service/api/auth/services/change_password
  body: json
  auth: inherit
}

headers {
  X-Fingerprint: {{X-Fingerprint}}
  Accept-Language: {{Accept-Language}}
  User-Agent: {{User-Agent}}
  Authorization:  Bearer {{JWT_ACCESS_TOKEN}}
}

body:json {
  {
    "old_password": "",
    "new_password": ""
  }
}

settings {
  encodeUrl: true
}
