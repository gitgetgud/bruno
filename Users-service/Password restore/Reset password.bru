meta {
  name: Reset password
  type: http
  seq: 1
}

post {
  url: https://{{ARM_HOST}}/proxy/users-service/api/auth/services/reset_password
  body: json
  auth: inherit
}

headers {
  X-Fingerprint: {{X-Fingerprint}}
  Accept-Language: {{Accept-Language}}
  User-Agent: {{User-Agent}}
}

body:json {
  {
      "login": "{{USERNAME_ENCRYPTED}}",
      "password": "{{NEW_PASSWORD_ENCRYPTED}}"
  }
}

script:pre-request {
  eval(bru.getGlobalEnvVar('pmlib_code'))
  
  let publicKey = bru.getEnvVar("PUBLIC_KEY")
  let username = bru.getEnvVar("USERNAME")
  let password = bru.getEnvVar("NEW_PASSWORD")
  let keyObj = pmlib.rs.KEYUTIL.getKey(publicKey)
  
  let usernameEncrypted = pmlib.rs.KJUR.crypto.Cipher.encrypt(username, keyObj, "RSA")
  let passwordEncrypted = pmlib.rs.KJUR.crypto.Cipher.encrypt(password, keyObj, "RSA")
  let base64UsernameEncrypted = Buffer.from(usernameEncrypted, "hex").toString("base64")
  let base64PasswordEncrypted = Buffer.from(passwordEncrypted, "hex").toString("base64")
  
  bru.setEnvVar("USERNAME_ENCRYPTED", base64UsernameEncrypted)
  bru.setEnvVar("NEW_PASSWORD_ENCRYPTED", base64PasswordEncrypted)
}

script:post-response {
  var jsonData = res.getBody()
  bru.setEnvVar("OPERATION_UUID", jsonData.data.operation_uuid)
}

settings {
  encodeUrl: true
}
