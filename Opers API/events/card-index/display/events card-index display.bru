meta {
  name: events card-index display
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/events/card-index/display/
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "iin": "stringstring",
    "iban": "stringstringstring"
  }
}

settings {
  encodeUrl: true
}

docs {
  Returns card index from IBSO
}

