meta {
  name: Поиск штрафов по ИИН, номеру удостоверения и сроку действия
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/rbk_pay/fines/penalties/search/
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "iin": "string",
    "doc_num": "string",
    "doc_issue_date": "1985-01-07"
  }
}

settings {
  encodeUrl: true
}

