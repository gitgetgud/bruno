meta {
  name: Поиск номера удостоверения личности и срока действия по ИИН
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/rbk_pay/fines/penalties/search_user_id_card/
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "iin": "string"
  }
}

settings {
  encodeUrl: true
}

example {
  name: Untitled Response
  
  request: {
    url: {{baseUrl}}/rbk_pay/fines/penalties/search_user_id_card/
    method: POST
    mode: json
    headers: {
      Content-Type: application/json
      Accept: application/json
      Authorization: Basic <credentials>
    }
  
    body:json: {
      {
        "iin": "string"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "iin": "string",
          "doc_num": "string",
          "doc_issue_date": "1986-10-20"
        }
      '''
    }
  }
}
