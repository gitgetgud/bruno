meta {
  name: Оплата ипотеки (Отбасы Банк)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/rbk_pay/otbasy/pay/
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "acc_alt_code": "string",
    "p_code": "string",
    "amount": "string",
    "currency": "KZT",
    "from_iban": "string",
    "account_iban": "string",
    "account_currency": "string",
    "iin": "st",
    "phone": "string"
  }
}

settings {
  encodeUrl: true
}

example {
  name: Untitled Response
  
  request: {
    url: {{baseUrl}}/rbk_pay/otbasy/pay/
    method: POST
    mode: json
    headers: {
      Content-Type: application/json
      Accept: application/json
      Authorization: Basic <credentials>
    }
  
    body:json: {
      {
        "acc_alt_code": "string",
        "p_code": "string",
        "amount": "string",
        "currency": "KZT",
        "from_iban": "string",
        "account_iban": "string",
        "account_currency": "string",
        "iin": "st",
        "phone": "string"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
