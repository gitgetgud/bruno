meta {
  name: Получение списка категорий
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/rbk_pay/paynet/v3/categories/?page=80&region_id=2
  body: none
  auth: inherit
}

params:query {
  page: 80
  region_id: 2
}

headers {
  Accept: application/json
}

settings {
  encodeUrl: true
}

example {
  name: Untitled Response
  
  request: {
    url: {{baseUrl}}/rbk_pay/paynet/v3/categories/?page=80&region_id=2
    method: GET
    mode: none
    params:query: {
      page: 80
      region_id: 2
    }
  
    headers: {
      Accept: application/json
      Authorization: Basic <credentials>
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "category_id": 7429,
          "title": "string",
          "icon_path": "string",
          "code": "string"
        }
      '''
    }
  }
}
