meta {
  name: Получение последнюю версию платежей
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/rbk_pay/payments/get_latest_version/?page=80
  body: none
  auth: inherit
}

params:query {
  page: 80
}

headers {
  Accept: application/json
}

settings {
  encodeUrl: true
}

example {
  name: Untitled Response
  
  request: {
    url: {{baseUrl}}/rbk_pay/payments/get_latest_version/?page=80
    method: GET
    mode: none
    params:query: {
      page: 80
    }
  
    headers: {
      Accept: application/json
      Authorization: Basic <credentials>
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "id": 8615,
          "created": "1967-12-10T18:16:32.442Z",
          "modified": "1950-12-13T10:14:37.996Z"
        }
      '''
    }
  }
}
