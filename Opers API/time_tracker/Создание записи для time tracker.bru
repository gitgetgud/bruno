meta {
  name: Создание записи для time tracker
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/time_tracker/
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "username": "str"
  }
}

settings {
  encodeUrl: true
}

example {
  name: Untitled Response
  
  request: {
    url: {{baseUrl}}/time_tracker/
    method: POST
    mode: json
    headers: {
      Content-Type: application/json
      Accept: application/json
      Authorization: Basic <credentials>
    }
  
    body:json: {
      {
        "username": "str"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {}
      '''
    }
  }
}

example {
  name: TimeTracker api is gone
  
  request: {
    url: {{baseUrl}}/time_tracker/
    method: POST
    mode: json
    headers: {
      Content-Type: application/json
      Authorization: Basic <credentials>
    }
  
    body:json: {
      {
        "username": "str"
      }
    }
  }
  
  response: {
    status: {
      code: 410
      text: Gone
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
