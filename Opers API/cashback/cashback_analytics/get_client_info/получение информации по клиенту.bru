meta {
  name: получение информации по клиенту
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/cashback/cashback_analytics/get_client_info/?page=80&client_id=string
  body: none
  auth: inherit
}

params:query {
  page: 80
  client_id: string
}

headers {
  Accept: application/json
}

settings {
  encodeUrl: true
}

example {
  name: Untitled Response
  
  request: {
    url: {{baseUrl}}/cashback/cashback_analytics/get_client_info/?page=80&client_id=string
    method: GET
    mode: none
    params:query: {
      page: 80
      client_id: string
    }
  
    headers: {
      Accept: application/json
      Authorization: Basic <credentials>
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "birthdate": "string",
          "iin": "string",
          "phone": "string",
          "client_id": "string",
          "app_installed": true,
          "language": "string",
          "is_sdbo_client": true
        }
      '''
    }
  }
}
