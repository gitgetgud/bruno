meta {
  name: Информация о типе карты
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/cashback/increased_cashback/card_info/?page=80&card_type=CLASSIC
  body: none
  auth: inherit
}

params:query {
  page: 80
  card_type: CLASSIC
}

headers {
  Accept: application/json
}

settings {
  encodeUrl: true
}

example {
  name: Untitled Response
  
  request: {
    url: {{baseUrl}}/cashback/increased_cashback/card_info/?page=80&card_type=CLASSIC
    method: GET
    mode: none
    params:query: {
      page: 80
      card_type: CLASSIC
    }
  
    headers: {
      Accept: application/json
      Authorization: Basic <credentials>
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "max_cashback_amount": 5170,
          "base_percent": 1006.0471952513117,
          "min_card_balance": 3629,
          "min_deposit_balance": 2773
        }
      '''
    }
  }
}
