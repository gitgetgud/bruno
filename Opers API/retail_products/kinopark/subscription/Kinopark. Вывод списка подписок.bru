meta {
  name: Kinopark. Вывод списка подписок
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/retail_products/kinopark/subscription/
  body: none
  auth: inherit
}

headers {
  Accept: application/json
}

settings {
  encodeUrl: true
}

example {
  name: Untitled Response
  
  request: {
    url: {{baseUrl}}/retail_products/kinopark/subscription/
    method: GET
    mode: none
    headers: {
      Accept: application/json
      Authorization: Basic <credentials>
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        [
          {
            "id": 6456,
            "name": "string",
            "description": "string",
            "price": "string",
            "visits_count": 1045
          },
          {
            "id": 7788,
            "name": "string",
            "description": "string",
            "price": "string",
            "visits_count": 4115
          }
        ]
      '''
    }
  }
}
