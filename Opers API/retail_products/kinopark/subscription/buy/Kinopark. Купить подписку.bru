meta {
  name: Kinopark. Купить подписку
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/retail_products/kinopark/subscription/buy/
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "subscription_id": 7959,
    "phone": "string",
    "from_iban": "string"
  }
}

settings {
  encodeUrl: true
}

example {
  name: Untitled Response
  
