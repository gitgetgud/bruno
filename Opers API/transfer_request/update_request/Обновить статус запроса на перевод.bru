meta {
  name: Обновить статус запроса на перевод
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/transfer_request/update_request/
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "transfer_request_id": "string",
    "status": "ACCEPT"
  }
}

settings {
  encodeUrl: true
}

example {
  name: Untitled Response
  
  request: {
    url: {{baseUrl}}/transfer_request/update_request/
    method: POST
    mode: json
    headers: {
      Content-Type: application/json
      Accept: application/json
      Authorization: Basic <credentials>
    }
  
    body:json: {
      {
        "transfer_request_id": "string",
        "status": "ACCEPT"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "transfer_request_id": "string"
        }
      '''
    }
  }
}
