meta {
  name: Получить список услуг доступных для бронирования
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/booking/booking/get_branch_services/?page=80&branch_id=80
  body: none
  auth: inherit
}

params:query {
  page: 80
  branch_id: 80
}

headers {
  Accept: application/json
}

settings {
  encodeUrl: true
}

example {
  name: Untitled Response
  
  request: {
    url: {{baseUrl}}/booking/booking/get_branch_services/?page=80&branch_id=80
    method: GET
    mode: none
    params:query: {
      page: 80
      branch_id: 80
    }
  
    headers: {
      Accept: application/json
      Authorization: Basic <credentials>
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "id": 5924,
          "name": "string",
          "queue_id": "string"
        }
      '''
    }
  }
}
