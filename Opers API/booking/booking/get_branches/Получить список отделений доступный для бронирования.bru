meta {
  name: Получить список отделений доступный для бронирования
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/booking/booking/get_branches/?page=80
  body: none
  auth: inherit
}

params:query {
  page: 80
}

headers {
  Accept: application/json
}

settings {
  encodeUrl: true
}

example {
  name: Untitled Response
  
  request: {
    url: {{baseUrl}}/booking/booking/get_branches/?page=80
    method: GET
    mode: none
    params:query: {
      page: 80
    }
  
    headers: {
      Accept: application/json
      Authorization: Basic <credentials>
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "name": "string",
          "nomad_terminal_code": "string",
          "start_working_time": "string",
          "end_working_time": "string",
          "id": 3663,
          "is_active": true
        }
      '''
    }
  }
}
