meta {
  name: Аналитика по карте
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/card/statements/rbs_history_analytics/?period=YEAR&rbs_number=string
  body: none
  auth: inherit
}

params:query {
  period: YEAR
  rbs_number: string
}

headers {
  Accept: application/json
}

settings {
  encodeUrl: true
}

