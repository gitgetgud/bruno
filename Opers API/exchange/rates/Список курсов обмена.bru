meta {
  name: Список курсов обмена
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/exchange/rates/?page=80
  body: none
  auth: inherit
}

params:query {
  page: 80
}

headers {
  Accept: application/json
}

settings {
  encodeUrl: true
}

example {
  name: Untitled Response
  
  request: {
    url: {{baseUrl}}/exchange/rates/?page=80
    method: GET
    mode: none
    params:query: {
      page: 80
    }
  
    headers: {
      Accept: application/json
      Authorization: Basic <credentials>
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "sell_price": "string",
          "buy_price": "string",
          "base_currency": "string",
          "currency": "string",
