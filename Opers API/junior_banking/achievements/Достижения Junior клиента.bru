meta {
  name: Достижения Junior клиента
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/junior_banking/achievements/?page=80
  body: none
  auth: inherit
}

params:query {
  page: 80
}

headers {
  Accept: application/json
}

settings {
  encodeUrl: true
}

