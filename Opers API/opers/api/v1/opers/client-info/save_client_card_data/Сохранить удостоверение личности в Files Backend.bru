meta {
  name: Сохранить удостоверение личности в Files Backend
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/opers/api/v1/opers/client-info/save_client_card_data/
  body: multipartForm
  auth: inherit
}

headers {
  Content-Type: multipart/form-data
  Accept: application/json
}

body:multipart-form {
  image: @file()
  iin: string
  log_id: string
}

settings {
  encodeUrl: true
}

example {
  name: Untitled Response
  
  request: {
    url: {{baseUrl}}/opers/api/v1/opers/client-info/save_client_card_data/
    method: POST
    mode: multipartForm
    headers: {
      Content-Type: multipart/form-data
      Accept: application/json
      Authorization: Basic <credentials>
    }
  
    body:multipart-form: {
      image: @file()
      iin: string
      log_id: string
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "iin": "string",
          "log_id": "string",
          "image": "https://hWXWJAdrvDCwzBTtSqFEcyXutjISdnCi.vjchsv+O"
        }
      '''
    }
  }
}
