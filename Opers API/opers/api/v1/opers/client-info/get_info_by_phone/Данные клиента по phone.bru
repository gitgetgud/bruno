meta {
  name: Данные клиента по phone
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/opers/api/v1/opers/client-info/get_info_by_phone/?page=80&phone=string
  body: none
  auth: inherit
}

params:query {
  page: 80
  phone: string
}

headers {
  Accept: application/json
}

settings {
  encodeUrl: true
}

example {
  name: Untitled Response
  
  request: {
    url: {{baseUrl}}/opers/api/v1/opers/client-info/get_info_by_phone/?page=80&phone=string
    method: GET
    mode: none
    params:query: {
      page: 80
      phone: string
    }
  
    headers: {
      Accept: application/json
      Authorization: Basic <credentials>
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "iban": "string",
          "iin": "string",
          "fio": "string",
          "phone": "string"
        }
      '''
    }
  }
}
