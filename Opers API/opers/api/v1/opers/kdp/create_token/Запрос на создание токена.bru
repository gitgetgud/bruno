meta {
  name: Запрос на создание токена
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/opers/api/v1/opers/kdp/create_token/
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "iin": "string",
    "phone": "string"
  }
}

settings {
  encodeUrl: true
}

example {
  name: Untitled Response
  
  request: {
    url: {{baseUrl}}/opers/api/v1/opers/kdp/create_token/
    method: POST
    mode: json
    headers: {
      Content-Type: application/json
      Authorization: Basic <credentials>
    }
  
    body:json: {
      {
        "iin": "string",
        "phone": "string"
      }
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
