  seq: 4
}

put {
  url: {{baseUrl}}/opers/api/v1/qr/:request_id/
  body: json
  auth: inherit
}

params:path {
  request_id: string
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
