meta {
  name: Список продуктов для открытия карты
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/opers/api/v1/core/card_emission/products_list/?iin=string&at_the_branch=string&search=string&ordering=string&page=80
  body: none
  auth: inherit
}

params:query {
  iin: string
  at_the_branch: string
  search: string
  ordering: string
  page: 80
}

headers {
  Accept: application/json
}

settings {
  encodeUrl: true
}

