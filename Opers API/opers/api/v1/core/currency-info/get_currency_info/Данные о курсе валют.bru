meta {
  name: Данные о курсе валют
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/opers/api/v1/core/currency-info/get_currency_info/?page=80
  body: none
  auth: inherit
}

params:query {
  page: 80
}

headers {
  Accept: application/json
}

settings {
  encodeUrl: true
}

example {
  name: Untitled Response
  
  request: {
    url: {{baseUrl}}/opers/api/v1/core/currency-info/get_currency_info/?page=80
    method: GET
    mode: none
    params:query: {
      page: 80
    }
  
    headers: {
      Accept: application/json
      Authorization: Basic <credentials>
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "rate": "string",
          "base_currency": "string",
          "currency": "string",
          "value": {
            "key_0": "string",
            "key_1": "string"
          }
        }
      '''
    }
  }
}
