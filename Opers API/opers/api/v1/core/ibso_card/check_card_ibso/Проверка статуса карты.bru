meta {
  name: Проверка статуса карты
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/opers/api/v1/core/ibso_card/check_card_ibso/
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "rbk_cards_id": "string"
  }
}

settings {
  encodeUrl: true
}

example {
  name: Untitled Response
  
  request: {
    url: {{baseUrl}}/opers/api/v1/core/ibso_card/check_card_ibso/
    method: POST
    mode: json
