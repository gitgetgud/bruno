meta {
  name: Процесс для вывода данных о менеджере
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/opers/api/v1/core/qr/employee_data/
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "iin": "stringstring"
  }
}

settings {
  encodeUrl: true
}

example {
  name: Untitled Response
  
  request: {
    url: {{baseUrl}}/opers/api/v1/core/qr/employee_data/
    method: POST
    mode: json
    headers: {
      Content-Type: application/json
      Accept: application/json
      Authorization: Basic <credentials>
    }
  
    body:json: {
      {
        "iin": "stringstring"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "firstName": "string",
          "lastName": "string",
          "position": "string",
          "branchNameKz": "string",
          "branchNameRu": "string",
          "email": "9HaI8zX7DPTwFh2@rVvnVMrHYhwfpYxztFZub.syno",
          "identificationNumber": "string",
          "middleName": "string"
        }
      '''
    }
  }
}
