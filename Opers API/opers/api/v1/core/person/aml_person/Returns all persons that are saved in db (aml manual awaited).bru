meta {
  name: Returns all persons that are saved in db (aml manual awaited).
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/opers/api/v1/core/person/aml_person/?page=80
  body: none
  auth: inherit
}

params:query {
  page: 80
}

headers {
  Accept: application/json
}

settings {
  encodeUrl: true
}

docs {
  Parameters
  ----------
      auth: filters out by user_id in jwt token
  
  Returns
  ----------
      Paginated response.
}

