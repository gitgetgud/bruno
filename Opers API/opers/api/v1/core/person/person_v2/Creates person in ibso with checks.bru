meta {
  name: Creates person in ibso with checks.
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/opers/api/v1/core/person/person_v2/
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "firstname": "string",
    "lastname": "string",
    "citizenship": "string",
    "resident": false,
    "isClient": true,
    "idn": ""
  }
}

settings {
  encodeUrl: true
}

docs {
  Info
  ----------
  `raises  400`: - if person is terrorist, in black list (ibso checks)...
                   - if person is aml
                   - if ibso could not save person
  `returns 202`: - if person is on manual aml
  `returns 200`: - if it could save person, returns client id object from ibso
}

example {
  name: Untitled Response
  
  request: {
    url: {{baseUrl}}/opers/api/v1/core/person/person_v2/
    method: POST
    mode: json
    headers: {
      Content-Type: application/json
      Accept: application/json
      Authorization: Basic <credentials>
    }
  
    body:json: {
      {
        "firstname": "string",
        "lastname": "string",
        "citizenship": "string",
        "resident": false,
        "isClient": true,
        "idn": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "firstname": "string",
          "lastname": "string",
          "citizenship": "string",
          "resident": false,
          "isClient": true,
          "idn": ""
        }
      '''
    }
  }
}
