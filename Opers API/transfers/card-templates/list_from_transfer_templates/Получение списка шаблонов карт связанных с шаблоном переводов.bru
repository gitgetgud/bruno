meta {
  name: Получение списка шаблонов карт связанных с шаблоном переводов
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/transfers/card-templates/list_from_transfer_templates/?page=80
  body: none
  auth: inherit
}

params:query {
  page: 80
}

headers {
  Accept: application/json
}

settings {
  encodeUrl: true
}

