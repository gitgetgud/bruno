meta {
  name: Получение UPT-перевода
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/transfers/upt-transfer/receive/
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "ref_number": "string",
    "to_iban": "string",
    "phone": "string",
    "currency": "string"
  }
}

settings {
  encodeUrl: true
}

example {
  name: Untitled Response
  
  request: {
    url: {{baseUrl}}/transfers/upt-transfer/receive/
    method: POST
    mode: json
    headers: {
      Content-Type: application/json
      Accept: application/json
      Authorization: Basic <credentials>
    }
  
    body:json: {
      {
        "ref_number": "string",
        "to_iban": "string",
        "phone": "string",
        "currency": "string"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "id": "string"
        }
      '''
    }
  }
}
