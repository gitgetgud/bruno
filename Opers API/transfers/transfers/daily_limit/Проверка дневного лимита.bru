meta {
  name: Проверка дневного лимита
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/transfers/transfers/daily_limit/?page=80&size=80&client_id=string
  body: none
  auth: inherit
}

params:query {
  page: 80
  size: 80
  client_id: string
}

headers {
  Accept: application/json
}

settings {
  encodeUrl: true
}

docs {
  API for Swift project to check limit.
}

example {
  name: Untitled Response
  
  request: {
    url: {{baseUrl}}/transfers/transfers/daily_limit/?page=80&size=80&client_id=string
    method: GET
    mode: none
    params:query: {
      page: 80
      size: 80
      client_id: string
    }
  
    headers: {
      Accept: application/json
      Authorization: Basic <credentials>
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "client_type": "string",
          "overall_amount": "string"
        }
      '''
    }
  }
}
