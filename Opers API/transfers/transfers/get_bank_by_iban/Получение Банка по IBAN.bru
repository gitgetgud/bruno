meta {
  name: Получение Банка по IBAN
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/transfers/transfers/get_bank_by_iban/?page=80&size=80&iban=string
  body: none
  auth: inherit
}

params:query {
  page: 80
  size: 80
  iban: string
}

headers {
  Accept: application/json
}

settings {
  encodeUrl: true
}

example {
  name: Untitled Response
  
  request: {
    url: {{baseUrl}}/transfers/transfers/get_bank_by_iban/?page=80&size=80&iban=string
    method: GET
    mode: none
    params:query: {
      page: 80
      size: 80
      iban: string
    }
  
    headers: {
      Accept: application/json
      Authorization: Basic <credentials>
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "bank_name": "s",
          "bank_code": "string"
        }
      '''
    }
  }
}
