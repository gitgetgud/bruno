meta {
  name: Получение список Банков СМП 2.0
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/transfers/transfers/smp_banks/?page=80&size=80
  body: none
  auth: inherit
}

params:query {
  page: 80
  size: 80
}

headers {
  Accept: application/json
}

settings {
  encodeUrl: true
}

example {
  name: Untitled Response
  
