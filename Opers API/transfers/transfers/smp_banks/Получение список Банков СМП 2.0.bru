    url: {{baseUrl}}/transfers/transfers/smp_banks/?page=80&size=80
    method: GET
    mode: none
    params:query: {
      page: 80
      size: 80
    }
  
    headers: {
      Accept: application/json
      Authorization: Basic <credentials>
    }
  }
  
  response: {
