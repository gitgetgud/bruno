meta {
  name: Получение списка Банков НПК
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/transfers/transfers/npck_banks/?page=80&size=80
  body: none
  auth: inherit
}

params:query {
  page: 80
  size: 80
}

headers {
  Accept: application/json
}

settings {
  encodeUrl: true
}

example {
  name: Untitled Response
  
  request: {
    url: {{baseUrl}}/transfers/transfers/npck_banks/?page=80&size=80
    method: GET
    mode: none
    params:query: {
      page: 80
      size: 80
    }
  
    headers: {
      Accept: application/json
      Authorization: Basic <credentials>
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        [
          {
            "providerId": "string",
            "name": "string",
