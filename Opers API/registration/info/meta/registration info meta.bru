meta {
  name: registration info meta
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/registration/info/meta/
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "iin": "stringstring",
    "device_id": "string"
  }
}

settings {
  encodeUrl: true
}

example {
  name: Untitled Response
  
  request: {
    url: {{baseUrl}}/registration/info/meta/
    method: POST
    mode: json
    headers: {
      Content-Type: application/json
      Accept: application/json
      Authorization: Basic <credentials>
    }
  
    body:json: {
      {
        "iin": "stringstring",
        "device_id": "string"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "iin": "stringstring",
          "device_id": "string"
        }
      '''
    }
  }
}
