meta {
  name: Изменить документ в карточке клиента ИБСО
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/registration/ibso_card/update_document/
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "iin": "stringstring",
    "full_name": "string",
    "document": {
      "doctype": "string",
      "docno": "string",
      "issueddate": "string",
      "enddate": "string",
      "issuedby": "string"
    },
    "phone": "string"
  }
}

settings {
  encodeUrl: true
}

example {
