meta {
  name: Auth url
  type: http
  seq: 2
}

get {
  url: {{KEYCLOAK_BASE_URL}}/auth/realms/{{REALM_NAME}}/protocol/openid-connect/auth?client_id={{CLIENT_ID}}&response_type=code&redirect_uri=http://localhost:3000/login
  body: none
  auth: inherit
}

params:query {
  client_id: {{CLIENT_ID}}
  response_type: code
  redirect_uri: http://localhost:3000/login
}

settings {
  encodeUrl: true
}

example {
  name: Auth url
  
  request: {
    url: {{KEYCLOAK_BASE_URL}}/auth/realms/{{REALM_NAME}}/protocol/openid-connect/auth?client_id={{CLIENT_ID}}&response_type=code&redirect_uri=http://localhost:3000/login
    method: GET
    mode: none
    params:query: {
      client_id: {{CLIENT_ID}}
      response_type: code
      redirect_uri: http://localhost:3000/login
    }
  }
  
  response: {
    headers: {
      Cache-Control: no-store, must-revalidate, max-age=0
      Set-Cookie: KC_RESTART=eyJhbGciOiJIUzI1NiIsInR5cCIgOiAiSldUIiwia2lkIiA6ICIzYWY4MjZmNS05MTRkLTQ2ZWMtYTc1Zi1jMDhkMzY5YzQzNzcifQ..RWSHq3JncgWlivxRlceFaVHVZj8W6sCdF2dxBADSHXo; Version=1; Path=/auth/realms/imageboardauth/; HttpOnly
      X-XSS-Protection: 1; mode=block
      X-Frame-Options: SAMEORIGIN
      Referrer-Policy: no-referrer
      Content-Security-Policy: frame-src 'self'; frame-ancestors 'self'; object-src 'none';
      Date: Fri, 03 Jun 2022 23:48:20 GMT
      Connection: keep-alive
      X-Robots-Tag: none
      Strict-Transport-Security: max-age=31536000; includeSubDomains
      X-Content-Type-Options: nosniff
      Content-Type: text/html;charset=utf-8
      Content-Length: 4691
      Content-Language: en
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: html
      content: '''
        <!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN"  "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
        <html xmlns="http://www.w3.org/1999/xhtml" class="login-pf">
            <head>
                <meta charset="utf-8">
                <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
                <meta name="robots" content="noindex, nofollow">
                <meta name="viewport" content="width=device-width,initial-scale=1"/>
                <title>Sign in to imageboardauth</title>
                <link rel="icon" href="/auth/resources/wjkpw/login/keycloak/img/favicon.ico" />
                <link href="/auth/resources/wjkpw/common/keycloak/web_modules/@patternfly/react-core/dist/styles/base.css" rel="stylesheet" />
                <link href="/auth/resources/wjkpw/common/keycloak/web_modules/@patternfly/react-core/dist/styles/app.css" rel="stylesheet" />
                <link href="/auth/resources/wjkpw/common/keycloak/node_modules/patternfly/dist/css/patternfly.min.css" rel="stylesheet" />
                <link href="/auth/resources/wjkpw/common/keycloak/node_modules/patternfly/dist/css/patternfly-additions.min.css" rel="stylesheet" />
                <link href="/auth/resources/wjkpw/common/keycloak/lib/pficon/pficon.css" rel="stylesheet" />
                <link href="/auth/resources/wjkpw/login/keycloak/css/login.css" rel="stylesheet" />
                <link href="/auth/resources/wjkpw/login/keycloak/css/tile.css" rel="stylesheet" />
            </head>
            <body class="">
                <div class="login-pf-page">
                    <div id="kc-header" class="login-pf-page-header">
                        <div id="kc-header-wrapper"
                     class="">imageboardauth</div>
                    </div>
                    <div class="card-pf">
                        <header class="login-pf-header">
                            <h1 id="kc-page-title">        Sign in to your account
        
        </h1>
                        </header>
                        <div id="kc-content">
                            <div id="kc-content-wrapper">
                                <div id="kc-form">
                                    <div id="kc-form-wrapper">
                                        <form id="kc-form-login" onsubmit="login.disabled = true; return true;" action="http://localhost:8080/auth/realms/imageboardauth/login-actions/authenticate?session_code=jiZyUmR4OCRWHv1t5aOEMIkmCGN6J822YmgaUvUZ8RY&amp;execution=7a09dee5-5678-4fac-9433-ff31a4b78015&amp;client_id=boardclient&amp;tab_id=qXhK1FZnLnM" method="post">
                                            <div class="form-group">
                                                <label for="username" class="pf-c-form__label pf-c-form__label-text">Username or email</label>
                                                <input tabindex="1" id="username" class="pf-c-form-control" name="username" value=""  type="text" autofocus autocomplete="off"
                                       aria-invalid=""
                                />
                                            </div>
                                            <div class="form-group">
                                                <label for="password" class="pf-c-form__label pf-c-form__label-text">Password</label>
                                                <input tabindex="2" id="password" class="pf-c-form-control" name="password" type="password" autocomplete="off"
                                   aria-invalid=""
                            />
                                            </div>
                                            <div class="form-group login-pf-settings">
                                                <div id="kc-form-options">
                                                    <div class="checkbox">
                                                        <label>
                                                            <input tabindex="3" id="rememberMe" name="rememberMe" type="checkbox"> Remember me
                                        
                                                        </label>
                                                    </div>
                                                </div>
                                                <div class="">
                                                    <span>
                                                        <a tabindex="5" href="/auth/realms/imageboardauth/login-actions/reset-credentials?client_id=boardclient&amp;tab_id=qXhK1FZnLnM">Forgot Password?</a>
                                                    </span>
                                                </div>
                                            </div>
                                            <div id="kc-form-buttons" class="form-group">
                                                <input type="hidden" id="id-hidden-input" name="credentialId" />
                                                <input tabindex="4" class="pf-c-button pf-m-primary pf-m-block btn-lg" name="login" id="kc-login" type="submit" value="Sign In"/>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                                <div id="kc-info" class="login-pf-signup">
                                    <div id="kc-info-wrapper" class="">
                                        <div id="kc-registration-container">
                                            <div id="kc-registration">
                                                <span>New user? 
                                                    <a tabindex="6"
                                                         href="/auth/realms/imageboardauth/login-actions/registration?client_id=boardclient&amp;tab_id=qXhK1FZnLnM">Register</a>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </body>
        </html>
      '''
    }
  }
}
