    'https://apiarm.kazincombank.kz/notifications/message/' \
    -H 'accept: application/json' \
    -H 'Content-Type: application/json' \
    -d '{
    "hooks": [],
    "data": "string",
    "message_type": "INFO",
    "customer_id": "string",
    "push_only": false,
