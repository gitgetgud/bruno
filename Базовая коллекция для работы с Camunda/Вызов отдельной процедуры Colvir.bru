meta {
  name: Вызов отдельной процедуры Colvir
  type: http
  seq: 6
}

post {
  url: https://dev-bcc-gf-gateway-green-front.apps.dev-env.bcc.kz/colvir/service/{укажите название процедуры из админки}
  body: json
  auth: inherit
}

headers {
  --colvir-user: COLVIR_GF
  --app-id: 0e42ca28-dc13-4244-a496-5596796d2bad
}

body:json {
  {
      "Переменная": "Значение переменной для старта нужной процедуры"
  }
}

settings {
  encodeUrl: true
}
