meta {
  name: List bucket items
  type: http
  seq: 1
}

get {
  url: {{S3_HOST}}/{{bucket}}
  body: none
  auth: awsv4
}

auth:awsv4 {
  accessKeyId: {{accessKey}}
  secretAccessKey: {{secretKey}}
  sessionToken: 
  service: s3
  region: us-east-1
  profileName: 
}

settings {
  encodeUrl: true
}

example {
  name: List bucket items
  
  request: {
    url: {{S3_HOST}}/{{bucket}}
    method: GET
    mode: none
  }
  
