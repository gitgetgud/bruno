meta {
  name: Personalized Push
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/notifications/personalized_push
  body: json
  auth: oauth2
}

headers {
  Content-Type: application/json
  Accept: application/json
}

auth:oauth2 {
  grant_type: password
  access_token_url: /notifications/login
  refresh_token_url: 
  username: 
  password: 
  client_id: 
  client_secret: 
  scope: 
  credentials_placement: basic_auth_header
  credentials_id: 
  token_source: access_token
  token_placement: url
  token_query_key: 
  auto_fetch_token: true
  auto_refresh_token: false
}

