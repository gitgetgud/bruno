meta {
  name: Send Push With Appid
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/notifications/message_app/
  body: json
  auth: basic
}

headers {
  Content-Type: application/json
  Accept: application/json
}

auth:basic {
  username: {{basicAuthUsername}}
  password: {{basicAuthPassword}}
}

body:json {
  {
    "data": "string",
    "customer_id": "string",
    "hooks": [
      "string",
      "string"
    ],
    "message_type": "INFO",
    "app_id": 6603
  }
}

settings {
  encodeUrl: true
}

docs {
  Send message with app_id
      {
          "data": "string",
          "customer_id": "string",
          "message_type": "string",
          "app_id": "string"
      }
}

example {
  name: Successful Response
  
  request: {
    url: {{baseUrl}}/notifications/message_app/
    method: POST
    mode: json
    headers: {
      Content-Type: application/json
      Accept: application/json
      Authorization: Basic <credentials>
    }
  
    body:json: {
      {
        "data": "string",
        "customer_id": "string",
        "hooks": [
          "string",
          "string"
        ],
        "message_type": "INFO",
        "app_id": 6603
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
  
      '''
    }
  }
}

example {
  name: Validation Error
  
  request: {
    url: {{baseUrl}}/notifications/message_app/
    method: POST
    mode: json
    headers: {
      Content-Type: application/json
      Accept: application/json
      Authorization: Basic <credentials>
    }
  
    body:json: {
      {
        "data": "string",
        "customer_id": "string",
        "hooks": [
          "string",
          "string"
        ],
        "message_type": "INFO",
        "app_id": 6603
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 422
