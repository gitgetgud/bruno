meta {
  name: Send Sms V1
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/notifications/send_sms/
  body: json
  auth: basic
}

headers {
  Content-Type: application/json
  Accept: application/json
}

auth:basic {
  username: {{basicAuthUsername}}
  password: {{basicAuthPassword}}
}

body:json {
  {
    "phone": "string",
    "message": "string",
    "customer_id": "",
    "initiator": ""
  }
}

settings {
  encodeUrl: true
}

example {
  name: Successful Response
  
  request: {
    url: {{baseUrl}}/notifications/send_sms/
    method: POST
    mode: json
    headers: {
      Content-Type: application/json
      Accept: application/json
      Authorization: Basic <credentials>
    }
  
    body:json: {
      {
        "phone": "string",
        "message": "string",
        "customer_id": "",
        "initiator": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
  
      '''
    }
  }
}

example {
  name: Validation Error
  
  request: {
    url: {{baseUrl}}/notifications/send_sms/
    method: POST
    mode: json
    headers: {
      Content-Type: application/json
      Accept: application/json
      Authorization: Basic <credentials>
    }
  
    body:json: {
      {
        "phone": "string",
        "message": "string",
        "customer_id": "",
        "initiator": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 422
      text: Unprocessable Entity (WebDAV) (RFC 4918)
    }
  
    body: {
      type: json
      content: '''
        {
          "detail": [
            {
              "loc": [
                "string",
                2136
              ],
              "msg": "string",
              "type": "string"
            },
            {
              "loc": [
                3462,
                "string"
              ],
              "msg": "string",
              "type": "string"
            }
          ]
        }
      '''
    }
  }
}
