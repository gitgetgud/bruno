meta {
  name: Get By Category
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/notifications/by-category-paginated/:category_id?page=0&page_size=100
  body: none
  auth: bearer
}

params:query {
  page: 0
  page_size: 100
}

params:path {
  category_id: string
}

headers {
  accept-language: ru
  Accept: application/json
}

auth:bearer {
  token: {{bearerToken}}
}

settings {
  encodeUrl: true
}

example {
  name: Successful Response
  
  request: {
    url: {{baseUrl}}/notifications/by-category-paginated/:category_id?page=0&page_size=100
    method: GET
    mode: none
    params:query: {
      page: 0
      page_size: 100
    }
  
    params:path: {
      category_id: string
    }
  
    headers: {
      accept-language: ru
      Accept: application/json
      Authorization: Bearer <token>
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
  
      '''
    }
  }
}

example {
  name: Validation Error
  
  request: {
    url: {{baseUrl}}/notifications/by-category-paginated/:category_id?page=0&page_size=100
    method: GET
    mode: none
    params:query: {
      page: 0
      page_size: 100
    }
  
    params:path: {
      category_id: string
    }
  
    headers: {
      accept-language: ru
      Accept: application/json
      Authorization: Bearer <token>
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 422
      text: Unprocessable Entity (WebDAV) (RFC 4918)
    }
  
    body: {
      type: json
      content: '''
        {
          "detail": [
            {
              "loc": [
                "string",
                2136
              ],
              "msg": "string",
              "type": "string"
            },
            {
              "loc": [
                3462,
                "string"
              ],
              "msg": "string",
              "type": "string"
            }
          ]
        }
      '''
    }
  }
}
