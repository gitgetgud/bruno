meta {
  name: Проверка
  type: http
  seq: 8
}

post {
  url: http://nca-node.infra.orb.local/cms/sign
  body: json
  auth: inherit
}

body:json {
  {
    "data": "{{documentsBase64}}",
    "signers": [
      {
        "key": "{{bccbiz_p12}}",
        "password": "{{bccbiz_p12_pass}}"
      }
    ],
    "withTsp": false,
    "tsaPolicy": "TSA_GOST_POLICY",
    "detached": false
  }
}

script:post-response {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
      var jsonData = res.getBody();
      pm.collectionVariables.set("signedDoc", jsonData.cms)
  });
  
}

settings {
  encodeUrl: true
}
