meta {
  name: Получение списка счетов
  type: http
  seq: 2
}

get {
  url: {{openapi_base_url}}/bcc/production/v1/business-account-management/accounts
  body: none
  auth: bearer
}

headers {
  x-client-token: {{bccbiz_access_token}}
}

auth:bearer {
  token: {{openapi_access_token}}
}

settings {
  encodeUrl: true
}

docs {
  # Метод получения списка счетов
  
  Метод предназначен для получения списка счетов Клиента.
}

