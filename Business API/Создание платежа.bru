script:post-response {
  test("Status code is 201", function () {
      expect(res.getStatus()).to.equal(201);
      var jsonData = res.getBody();
      pm.collectionVariables.set("paymentID", jsonData.id)
  });
  
}

settings {
  encodeUrl: true
}

docs {
  # Метод для создания платежа
  
  предназначен для инициирования нового платежного поручения (перевода) от имени Клиента через платформу Партнёра.
  
  С его помощью приложение Партнёра формирует черновик платежа в статусе "Создан", который затем может быть подписан уполномоченным лицом.
  
  
}

