meta {
  name: Подписание
  type: http
  seq: 7
}

post {
  url: http://nca-node.infra.orb.local/cms/sign
  body: json
  auth: inherit
}

body:json {
  {
    "data": "{{documentsBase64}}",
    "signers": [
      {
        "key": "{{bccbiz_p12}}",
        "password": "{{bccbiz_p12_pass}}"
      }
    ],
    "withTsp": false,
    "tsaPolicy": "TSA_GOST_POLICY",
    "detached": false
  }
}

script:post-response {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
      var jsonData = res.getBody();
      pm.collectionVariables.set("signedDoc", jsonData.cms)
  });
  
}

settings {
  encodeUrl: true
}

example {
  name: Подписание
  
  request: {
    url: http://nca-node.infra.orb.local/cms/sign
    method: POST
    mode: json
    body:json: {
      {
        "data": "{{documentsBase64}}",
        "signers": [
          {
            "key": "",
            "password": "Qwerty12"
          //   "keyAlias": "<string>"
          }
        ],
        "withTsp": false,
        "tsaPolicy": "TSA_GOST_POLICY",
        "detached": false
      }
    }
  }
  
  response: {
    headers: {
      Vary: Origin
      Vary: Access-Control-Request-Method
      Vary: Access-Control-Request-Headers
      Content-Type: application/json
      Transfer-Encoding: chunked
      Date: Tue, 03 Feb 2026 05:53:19 GMT
      Keep-Alive: timeout=60
      Connection: keep-alive
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
            "status": 200,
            "message": "OK",
            "cms": ""
        }
      '''
    }
  }
}
