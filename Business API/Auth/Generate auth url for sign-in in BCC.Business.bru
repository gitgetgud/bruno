meta {
  name: Generate auth url for sign-in in BCC.Business
  type: http
  seq: 2
}

post {
  url: {{openapi_base_url}}/bcc/production/v1/auth-client/generate-auth-url
  body: formUrlEncoded
  auth: bearer
}

auth:bearer {
  token: {{openapi_access_token}}
}

body:form-urlencoded {
  scope: oapi.business.account.api
  client_idn: 991040006615
  redirect_uri: http://localhost:3000/callback
}

settings {
  encodeUrl: true
}

