meta {
  name: [FE]<->[BE]:  verify-otp - Сервис верификации ОТП
  type: http
  seq: 1
}

post {
  url: https://test.centermarket.kz/bank/bcc/leasing/v1/application/{{online_auto_leasing_id}}/verify-otp
  body: json
  auth: inherit
}

headers {
  accept: application/json
  Content-Type: application/json
  Cookie: cm_sid={{cm_sid}}
  ~X-User-ID: +77777777777
}

body:json {
  {
    "otp": "1234"
  }
}

settings {
  encodeUrl: true
}

example {
  name: [FE]<->[BE]:  verify-otp - Сервис верификации ОТП
  
  request: {
    url: https://test.centermarket.kz/bank/bcc/leasing/v1/application/7b296d2b-c4d6-4d31-b9c2-8e7156d639c3/verify-otp?
    method: POST
    mode: json
    headers: {
      accept: application/json
      Content-Type: application/json
      ~X-User-ID: +77777777777
      Cookie: cm_
    }
  
    body:json: {
      {
        "otp": "1234"
      }
    }
  }
  
  response: {
    headers: {
      Server: nginx/1.25.5
      Date: Mon, 02 Mar 2026 07:13:26 GMT
      Content-Type: application/json
      Content-Length: 104
      Connection: keep-alive
      content-encoding: gzip
      vary: Origin
      vary: Accept-Encoding
      Content-Security-Policy: frame-ancestors 'self' *.bcc.kz *.centermarket.kz *.bcchub.kz
    }
  
    status: {
      code: 500
      text: Internal Server Error
    }
  
    body: {
      type: json
      content: '''
        {
            "status": 500,
            "success": false,
            "error": "E_INTERNAL_SERVER",
            "message": "status failed"
        }
      '''
    }
  }
}
