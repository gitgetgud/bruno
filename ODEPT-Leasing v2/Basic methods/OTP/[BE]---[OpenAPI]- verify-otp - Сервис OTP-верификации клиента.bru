meta {
  name: [BE]<->[OpenAPI]: verify-otp - Сервис OTP-верификации клиента
  type: http
  seq: 2
}

post {
  url: {{gateway_host}}/bcc/production/api/v1/loans/application/sme-leasing/:sme-leasing-uuid/verify-otp
  body: json
  auth: bearer
}

params:path {
  sme-leasing-uuid: {{online_auto_leasing_id}}
}

headers {
  X-User-ID: +77777777777
  accept: application/json
  content-type: application/json
}

auth:bearer {
  token: {{x_ibm_access_token}}
}

body:json {
  {
      "password": "1234"
  }
}

settings {
  encodeUrl: true
}

example {
  name: VERIFICATION SUCCESS - 200
  
  request: {
    url: {{gateway_host}}/bcc/production/api/v1/loans/application/sme-leasing/:sme-leasing-uuid/verify-otp
    method: POST
    mode: json
    params:path: {
      sme-leasing-uuid: {{online_auto_leasing_id}}
    }
  
    headers: {
      X-User-ID: +77777777777
      accept: application/json
      content-type: application/json
    }
  
    body:json: {
      {
          "message": {
              "ru": "",
              "kz": ""
          },
          "password": "1234"
      }
    }
  }
  
  response: {
    headers: {
      X-Backside-Transport: OK OK
      Connection: Keep-Alive
      Transfer-Encoding: chunked
