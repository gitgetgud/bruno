meta {
  name: [FE]: Info - Сервис получения информации о состоянии заявки
  type: http
  seq: 1
}

get {
  url: https://test.centermarket.kz/bank/bcc/leasing/v1/application/info?bin={{bin}}
  body: none
  auth: inherit
}

params:query {
  bin: {{bin}}
  ~id: {{online_auto_leasing_id}}
}

headers {
  accept: application/json
  Cookie: cm_sid={{cm_sid}}
}

settings {
  encodeUrl: true
}

example {
  name: [FE]<->[BE]: Info - Сервис получения информации о состоянии заявки
  
  request: {
    url: https://odept.kz/api/bcc-leasing/v1/leasing/applications/info?bin=050640003525
    method: GET
    mode: none
    params:query: {
      bin: 050640003525
      ~id: bf3289e9-7476-4a8c-b05a-ab53cdf404b0
    }
  
    headers: {
      accept: application/json
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    body: {
      type: json
      content: '''
        {
            "status": 200,
            "success": true,
            "data": {
                "eventName": "SCORING_RESULTS",
                "id": "15d7576b-361e-4844-a65a-01f05d30982c",
                "orderNumber": "2026363567",
                "processDefinitionFKey": "auto_leasing_new",
                "processInfo": {
                    "comments": {
                        "kz": "",
                        "ru": ""
                    },
                    "stageName": {
                        "kz": "Результат проверок",
                        "ru": "Результат проверок"
                    },
                    "processingEventStatus": "UNPROCESSED",
                    "status": "ACTIVE"
                }
            }
        }
      '''
    }
  }
}

