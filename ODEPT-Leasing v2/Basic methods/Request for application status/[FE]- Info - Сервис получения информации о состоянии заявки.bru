example {
  name: [FE]: Info - Сервис получения информации о состоянии заявки
  
  request: {
    url: https://test.centermarket.kz/bank/bcc/leasing/v1/application/info?id=d323dc47-1f88-4050-b8eb-8a245f1e062d
    method: GET
    mode: none
    params:query: {
      ~bin: 050640003525
      id: d323dc47-1f88-4050-b8eb-8a245f1e062d
    }
  
    headers: {
      accept: application/json
      Cookie: cm_
    }
  }
  
  response: {
    headers: {
      Server: nginx/1.25.5
      Date: Mon, 02 Mar 2026 06:59:10 GMT
      Content-Type: application/json
      Content-Length: 346
      Connection: keep-alive
      content-encoding: gzip
      vary: Origin
      vary: Accept-Encoding
      Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
      Content-Security-Policy: frame-ancestors 'self' *.bcc.kz *.centermarket.kz *.bcchub.kz
      X-Content-Type-Options: nosniff
      X-Permitted-Cross-Domain-Policies: none
      Permissions-Policy: geolocation=(),midi=(),sync-xhr=(),microphone=(),camera=(),magnetometer=(),gyroscope=(),fullscreen=(self),payment=()
      X-XSS-Protection: 1; mode=block
      Referrer-Policy: no-referrer-when-downgrade
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
            "status": 200,
            "success": true,
            "data": {
                "id": "d323dc47-1f88-4050-b8eb-8a245f1e062d",
                "eventName": "VERIFICATION",
                "orderNumber": "2040171267",
                "processDefinitionFKey": "auto_leasing_new",
                "processInfo": {
                    "comments": {
                        "ru": "",
                        "kz": ""
                    },
                    "stageName": {
                        "ru": "Верификация клиента по ОТП",
                        "kz": "ОТП арқылы клиентті тексеру"
                    }
                },
                "processingEventStatus": "UNPROCESSED",
                "status": "ACTIVE"
            }
        }
      '''
    }
  }
}

