meta {
  name: [BE]<->[OpenAPI]: info - Статус онлайн заявки
  type: http
  seq: 3
}

get {
  url: {{gateway_host}}/bcc/production/api/v1/loans/application/sme-leasing/info/:sme-leasing-uuid
  body: none
  auth: bearer
}

params:path {
  sme-leasing-uuid: {{online_auto_leasing_id}}
}

headers {
  X-User-ID: +77777777777
}

auth:bearer {
  token: {{x_ibm_access_token}}
}

settings {
  encodeUrl: true
}

example {
  name: OTP_SEND: VERIFICATION-UNPROCESSED
  
  request: {
    url: {{gateway_host}}/bcc/production/api/v1/loans/application/sme-leasing/info/98edfb9e-7563-438c-9705-cb4b1346030a
    method: GET
    mode: none
    headers: {
      X-User-ID: +77777777777
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    body: {
      type: json
      content: '''
        {
            "eventName": "VERIFICATION",
            "id": "88fed386-c78e-42ae-8440-bc6c4c1eae92",
            "orderNumber": "2023255477",
            "processDefinitionFKey": "auto_leasing_new",
            "processInfo": {
                "comments": {
                    "kz": "",
                    "ru": ""
                },
