                },
                "stageName": {
                    "kz": "Получение данных Уполномоченного лица",
                    "ru": "Получение данных Уполномоченного лица"
                }
            },
            "processingEventStatus": "PROCESSED",
            "status": "ACTIVE"
        }
      '''
