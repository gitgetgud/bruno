    method: GET
    mode: none
    params:path: {
      iin: 850525300700
    }
  
    headers: {
      X-User-ID: +77777777777
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    body: {
      type: json
      content: '''
        {
            "eventName": "BANK_REJECTED",
