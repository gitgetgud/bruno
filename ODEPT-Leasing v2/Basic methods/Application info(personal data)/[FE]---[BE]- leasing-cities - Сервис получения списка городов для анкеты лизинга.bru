meta {
  name: [FE]<->[BE]: leasing/cities - Сервис получения списка городов для анкеты лизинга
  type: http
  seq: 1
}

get {
  url: https://test.centermarket.kz/bank/bcc/leasing/v1/cities
  body: none
  auth: inherit
}

headers {
  accept: application/json
  Cookie: cm_sid={{cm_sid}}
}

settings {
  encodeUrl: true
}

example {
  name: [FE]<->[BE]: leasing/cities - Сервис получения списка городов для анкеты лизинга
  
  request: {
    url: https://test.centermarket.kz/bank/bcc/leasing/v1/cities
    method: GET
    mode: none
    headers: {
      accept: application/json
      Cookie: cm_
    }
  }
  
  response: {
    headers: {
      Server: nginx/1.25.5
      Date: Mon, 02 Mar 2026 06:52:26 GMT
      Content-Type: application/json
      Content-Length: 747
      Connection: keep-alive
      content-encoding: gzip
      vary: Origin
      vary: Accept-Encoding
      Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
      Content-Security-Policy: frame-ancestors 'self' *.bcc.kz *.centermarket.kz *.bcchub.kz
      X-Content-Type-Options: nosniff
      X-Permitted-Cross-Domain-Policies: none
      Permissions-Policy: geolocation=(),midi=(),sync-xhr=(),microphone=(),camera=(),magnetometer=(),gyroscope=(),fullscreen=(self),payment=()
      X-XSS-Protection: 1; mode=block
      Referrer-Policy: no-referrer-when-downgrade
    }
  
    status: {
