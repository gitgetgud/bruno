meta {
  name: cities - Сервис получения списка филиалов БЦК
  type: http
  seq: 2
}

get {
  url: {{gateway_host}}/bcc/production/api/v1/directory/cities
  body: none
  auth: bearer
}

auth:bearer {
  token: {{x_ibm_access_token}}
}

settings {
  encodeUrl: true
}

