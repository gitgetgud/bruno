meta {
  name: [BE]<->[OpenAPI]: sme-leasing - Сервис создания заявки на автолизинг
  type: http
  seq: 2
}

post {
  url: {{gateway_host}}/bcc/production/api/v1/loans/application/sme-leasing
  body: json
  auth: bearer
}

headers {
  X-Initiator-System: OPEN_API
  X-Process-Definition-F-Key: auto_leasing_new
  X-System-Owner: GREEN_FRONT
  X-User-ID: +77777777777
  accept: application/json
  content-type: application/json
}

auth:bearer {
  token: {{x_ibm_access_token}}
}

body:json {
  {
      "clientInfo": {
        "iin": "230840009217",
        "mobile": "+77777777777",
        "registrationDate": "2026-02-18",
        "branch": {
          "dep_id": 1614,
          "id": 1614,
          "longname": "Центральное отделение №0102",
          "code": "AQ5",
          "filial": "ALM"
        },
        "city": {
          "code": "ALM"
      }
    },
     "partnerInfo": {
        "bin": "050640003525",
        "longname": "ТОО Allur Distribution"
      },
      "creditInfo": {
        "amount": 20000000,
        "loanAmount": 16000000,
        "advanceAmount": 4000000,
        "term": 37,
