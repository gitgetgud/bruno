            "prodCountryName": "КНР",
            "prodCountry": "CN",
            "buildYear": 2025
          }
        ]
      }
    }
}

script:post-response {
  let responseData = res.getBody();
  bru.setEnvVar("online_auto_leasing_id", responseData.id);
}

settings {
  encodeUrl: true
}

