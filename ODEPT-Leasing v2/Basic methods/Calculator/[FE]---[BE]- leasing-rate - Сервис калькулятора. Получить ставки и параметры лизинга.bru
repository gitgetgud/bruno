meta {
  name: [FE]<->[BE]: leasing/rate - Сервис калькулятора. Получить ставки и параметры лизинга.
  type: http
  seq: 1
}

post {
  url: https://test.centermarket.kz/bank/bcc/leasing/v1/rates
  body: json
  auth: inherit
}

headers {
  accept: application/json
  Cookie: cm_
}

body:json {
  {
      "company_id": "{{company_id}}",
      "merchant_id": "{{merchant_id}}",
      "merchant_items_ids": [ "{{merchant_items_ids}}"
      ]
  }
  
}

settings {
  encodeUrl: true
}

example {
  name: [FE]<->[BE]: leasing/rate - Сервис калькулятора. Получить ставки и параметры лизинга.
  
  request: {
    url: https://test.centermarket.kz/bank/bcc/leasing/v1/rates
    method: POST
    mode: json
    headers: {
      accept: application/json
    }
  
    body:json: {
      {
          "company_id": "{{company_id}}",
          "merchant_id": "{{merchant_id}}",
          "merchant_items_ids": [ "{{merchant_items_ids}}"
          ]
      }
      
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    body: {
      type: json
      content: '''
        {
          "status": "200",
          "success": true,
          "data": {
            "rate_advance": [
              {
                "months": 37,
                "advance": "15",
                "rate": 24.3
              }
            ],
            "max_min_sums": [
              {
                "name": "10%",
                "min_sum": 5555556,
                "max_sum": 77777777
              }
            ],
            "items_info": [
              {
                "car_mark": "GEELY",
                "car_model": "MONJARO",
                "country_code": "CN",
                "name_country": "КНР",
                "build_year": 2025
              }
            ],
            "company_info": {
              "company_id": "3cd6f5cf-cad7-439f-903d-083dd8aff7c7",
              "bin": "050640003525"
            },
            "merchant_info": {
              "merchant_id": "3cd6f5cf-cad7-439f-903d-083dd8aff7c7",
              "bin": "050640003525",
              "short_name": "ТОО \"Allur Distribution\""
            }
          }
        }
      '''
    }
  }
}

