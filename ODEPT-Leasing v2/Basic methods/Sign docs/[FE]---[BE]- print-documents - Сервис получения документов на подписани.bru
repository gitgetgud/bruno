meta {
  name: [FE]<->[BE]: print-documents - Сервис получения документов на подписани
  type: http
  seq: 1
}

get {
  url: https://test.centermarket.kz/bank/bcc/leasing/v1/application/{{online_auto_leasing_id}}/print-documents
  body: none
  auth: inherit
}

headers {
  accept: application/pdf
}

settings {
  encodeUrl: true
}

example {
  name: [FE]<->[BE]: print-documents - Сервис получения документов на подписани
  
  request: {
    url: https://test.centermarket.kz/bank/bcc/leasing/v1/application/b1174ec8-40b6-45d4-b957-5a591a6d94b9/print-documents
    method: GET
    mode: none
    headers: {
      accept: application/pdf
    }
  }
  
  response: {
    headers: {
      Server: nginx/1.25.5
      Date: Fri, 27 Feb 2026 10:24:43 GMT
      Content-Type: application/json
      Transfer-Encoding: chunked
      Connection: keep-alive
      content-encoding: gzip
      vary: Origin
      vary: Accept-Encoding
      Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
      Content-Security-Policy: frame-ancestors 'self' *.bcc.kz *.centermarket.kz *.bcchub.kz
      X-Content-Type-Options: nosniff
